# Streamlit secrets TEMPLATE — placeholders only, safe to commit.
#
# Local dev:  copy to .streamlit/secrets.toml (gitignored) and fill in,
#             OR use a .env file. Do NOT commit real values.
# Streamlit Cloud:  paste the filled version into
#             App → Settings → Secrets (the built-in secret manager).
#
# These keys are propagated to os.environ at startup, so they configure the
# weight ensemble, densities, and pricing as well as the engine.

FAL_KEY = "your-fal-api-key-here"   # always needed (montage + dimensioned views run on fal)

# ── Vision reasoning: Opus 4.8 via AWS Bedrock (high-accuracy, opt-in) ────────
# WEIGHT_MODEL_PRIMARY    = "anthropic-direct/claude-opus-4-8"
# WEIGHT_MODEL_SECONDARY  = ""          # empty = Opus only (no ensemble/fallback)
# WEIGHT_FALLBACK_MODELS  = ""
# WEIGHT_ANTHROPIC_BACKEND = "bedrock"  # or "api" with ANTHROPIC_API_KEY
# AWS_REGION              = "us-east-1"
# BEDROCK_MODEL_CLAUDE_OPUS_4_8 = "us.anthropic.claude-opus-4-8"  # YOUR exact id
# BEDROCK_MODEL_CLAUDE_FABLE_5 = "us.anthropic.claude-fable-5"    # only if using Fable
# Bedrock credentials — EITHER a single Bedrock API key (bearer token):
# AWS_BEARER_TOKEN_BEDROCK = "..."
# OR IAM access key/secret:
# AWS_ACCESS_KEY_ID       = "AKIA..."
# AWS_SECRET_ACCESS_KEY   = "..."
# AWS_SESSION_TOKEN       = "..."       # only if using temporary creds
#
# ── Optional overrides (sensible defaults exist; omit unless tuning) ──────────
# WEIGHT_MODEL_PRIMARY   = "google/gemini-2.5-pro"   # default fal ensemble
# WEIGHT_MODEL_SECONDARY = "anthropic/claude-sonnet-4.5"
# METAL_MARKUP           = "1.25"
# CASTING_FACTOR         = "0.97"
# DENSITY_18K_GOLD       = "15.60"
# DENSITY_14K_GOLD       = "13.07"
# DENSITY_PLATINUM_950   = "20.10"
#
# Do NOT set FORGE_DEMO in the cloud — that forces the offline sample mode.
