# ── Engine ──────────────────────────────────────────────────────────────────
FAL_KEY=your-fal-api-key-here

# ── Weight estimator (ensemble, swappable) ───────────────────────────────────
# OpenRouter model ids (any-llm/vision forwards to OpenRouter). Primary is the
# latest Gemini; gemini-2.5-pro stays in the fallback chain in case the endpoint
# hasn't whitelisted gemini-3 yet.
WEIGHT_MODEL_PRIMARY=google/gemini-3-pro-preview
WEIGHT_MODEL_SECONDARY=anthropic/claude-sonnet-4.5
# WEIGHT_FALLBACK_MODELS=google/gemini-2.5-pro,openai/gpt-5-chat,google/gemini-3-flash-preview

# ── Metal densities (g/cm^3) — used for weight = volume * density ─────────────
DENSITY_24K_GOLD=19.32
DENSITY_22K_GOLD=17.80
DENSITY_18K_GOLD=15.60
DENSITY_14K_GOLD=13.07
DENSITY_10K_GOLD=11.60
DENSITY_PLATINUM_950=20.10
DENSITY_SILVER_925=10.36

# ── Pricing ──────────────────────────────────────────────────────────────────
# Multiplier applied to metal cost (1.0 = at-cost, 1.25 = +25% markup).
METAL_MARKUP=1.0
# Casting porosity factor: cast pieces weigh slightly less than solid volume.
CASTING_FACTOR=0.97
