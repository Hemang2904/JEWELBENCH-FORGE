# ── Engine ──────────────────────────────────────────────────────────────────
FAL_KEY=your-fal-api-key-here

# ── Weight estimator (ensemble, swappable) ───────────────────────────────────
# DEFAULT: fal-hosted ensemble — gemini-2.5-pro + Claude Sonnet 4.5 (best-suited
# pairing on fal for this task; only needs FAL_KEY). Median + outlier rejection
# across the ensemble targets <=10% deviation.
WEIGHT_MODEL_PRIMARY=google/gemini-2.5-pro
WEIGHT_MODEL_SECONDARY=anthropic/claude-sonnet-4.5
WEIGHT_FALLBACK_MODELS=google/gemini-2.5-flash,openai/gpt-5
WEIGHT_ANTHROPIC_BACKEND=api
#
# HIGH-ACCURACY UPGRADE (opt-in) — Opus 4.8 + Fable 5 (not on fal). Any
# "anthropic-direct/" or "bedrock/" id (or an "opus"/"fable" name) routes off fal:
#   WEIGHT_MODEL_PRIMARY=anthropic-direct/claude-opus-4-8
#   WEIGHT_MODEL_SECONDARY=anthropic-direct/claude-fable-5
# via the Anthropic API:      WEIGHT_ANTHROPIC_BACKEND=api  + ANTHROPIC_API_KEY=sk-ant-...
# via AWS Bedrock:            WEIGHT_ANTHROPIC_BACKEND=bedrock  + boto3 + AWS creds
#   AWS_REGION=us-east-1
#   BEDROCK_MODEL_CLAUDE_OPUS_4_8=us.anthropic.claude-opus-4-8   # YOUR profile ids
#   BEDROCK_MODEL_CLAUDE_FABLE_5=us.anthropic.claude-fable-5
#   # creds: EITHER a Bedrock API key (bearer)  AWS_BEARER_TOKEN_BEDROCK=...
#   #        OR IAM access key/secret  AWS_ACCESS_KEY_ID=... AWS_SECRET_ACCESS_KEY=...

# View renderer (consistent multi-angle). Flux Kontext [max] keeps the same ring
# across views at top fidelity; alternatives: fal-ai/flux-pro/kontext (cheaper)
# or fal-ai/nano-banana-pro/edit.
# VIEW_MODEL=fal-ai/nano-banana-pro/edit  # default; flux-pro/kontext only does edits, not angle changes

# ── Metal densities (g/cm^3) — used for weight = volume * density ─────────────
DENSITY_24K_GOLD=19.32
DENSITY_22K_GOLD=17.80
DENSITY_18K_GOLD=15.60
DENSITY_14K_GOLD=13.07
DENSITY_10K_GOLD=11.60
DENSITY_PLATINUM_950=20.10
DENSITY_SILVER_925=10.36

# ── Pricing ──────────────────────────────────────────────────────────────────
# Multiplier applied to metal cost (1.0 = at-cost, 1.25 = +25% markup).
METAL_MARKUP=1.0
# Casting porosity factor: cast pieces weigh slightly less than solid volume.
CASTING_FACTOR=0.97
