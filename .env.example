# ── Engine ──────────────────────────────────────────────────────────────────
FAL_KEY=your-fal-api-key-here

# ── Weight estimator (ensemble, swappable) ───────────────────────────────────
# fal any-llm/vision model ids. gemini-3-pro-preview is NOT enabled there, so we
# use gemini-2.5-pro (latest working Gemini) + Claude Sonnet 4.5.
WEIGHT_MODEL_PRIMARY=google/gemini-2.5-pro
WEIGHT_MODEL_SECONDARY=anthropic/claude-sonnet-4.5
# WEIGHT_FALLBACK_MODELS=openai/gpt-5-chat,google/gemini-2.5-flash

# Opus is NOT on fal — to add it to the ensemble it's called via the Anthropic
# API directly. Set ANTHROPIC_API_KEY and use an Opus id as a weight model, e.g.
#   WEIGHT_MODEL_PRIMARY=claude-opus-4-8   (any id containing "opus" routes direct)
# ANTHROPIC_API_KEY=sk-ant-...

# View renderer (consistent multi-angle). Flux Kontext [max] keeps the same ring
# across views at top fidelity; alternatives: fal-ai/flux-pro/kontext (cheaper)
# or fal-ai/nano-banana-pro/edit.
# VIEW_MODEL=fal-ai/nano-banana-pro/edit  # default; flux-pro/kontext only does edits, not angle changes

# ── Metal densities (g/cm^3) — used for weight = volume * density ─────────────
DENSITY_24K_GOLD=19.32
DENSITY_22K_GOLD=17.80
DENSITY_18K_GOLD=15.60
DENSITY_14K_GOLD=13.07
DENSITY_10K_GOLD=11.60
DENSITY_PLATINUM_950=20.10
DENSITY_SILVER_925=10.36

# ── Pricing ──────────────────────────────────────────────────────────────────
# Multiplier applied to metal cost (1.0 = at-cost, 1.25 = +25% markup).
METAL_MARKUP=1.0
# Casting porosity factor: cast pieces weigh slightly less than solid volume.
CASTING_FACTOR=0.97
